{
  "manifest_version": 3,
  "name": "ZOOAI X-Ray",
  "short_name": "X-Ray",
  "version": "0.1.0",
  "description": "See who you're buying from. Opens the X-Ray of the Solana token on the page you trade on.",
  "action": {
    "default_title": "ZOOAI X-Ray",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab"]
}

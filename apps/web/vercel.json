{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(terminals|research)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/docs/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/skill.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/x402",
      "destination": "https://north.zooaiagency.com/v1/x402"
    },
    {
      "source": "/api/usage",
      "destination": "https://north.zooaiagency.com/v1/usage"
    },
    {
      "source": "/api/check/:mint",
      "destination": "https://north.zooaiagency.com/v1/check/:mint"
    },
    {
      "source": "/api/north/:path*",
      "destination": "https://north.zooaiagency.com/:path*"
    },
    {
      "source": "/api/xray/:mint",
      "destination": "https://north.zooaiagency.com/v1/xray/:mint"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/:slug([a-z0-9-]+)",
      "destination": "/docs.html"
    },
    {
      "source": "/callers",
      "destination": "/index.html"
    },
    {
      "source": "/volume",
      "destination": "/index.html"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    },
    {
      "source": "/stats",
      "destination": "/index.html"
    },
    {
      "source": "/roadmap",
      "destination": "/index.html"
    },
    {
      "source": "/x402",
      "destination": "/index.html"
    },
    {
      "source": "/feed",
      "destination": "/index.html"
    },
    {
      "source": "/contests",
      "destination": "/index.html"
    },
    {
      "source": "/xray",
      "destination": "/xray.html"
    }
  ],
  "redirects": [
    {
      "source": "/x-ray",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/scan",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/check",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/bot",
      "destination": "https://t.me/zooaiagency_bot",
      "permanent": true
    },
    {
      "source": "/live",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/brief",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/evolution",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/evolution.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ask",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/rugs",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/rug",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/cabals",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/radar",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/app.html",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/agents",
      "destination": "/contests",
      "permanent": true
    },
    {
      "source": "/play",
      "destination": "/contests",
      "permanent": true
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(zones|agents|animals|backdrops|evolution)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/docs/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/skill.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/usage",
      "destination": "https://north-production-3f77.up.railway.app/v1/usage"
    },
    {
      "source": "/api/check/:mint",
      "destination": "https://north-production-3f77.up.railway.app/v1/check/:mint"
    },
    {
      "source": "/api/xray/:mint",
      "destination": "https://north-production-3f77.up.railway.app/v1/xray/:mint"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/:slug([a-z0-9-]+)",
      "destination": "/docs.html"
    },
    {
      "source": "/evolution",
      "destination": "/evolution.html"
    },
    {
      "source": "/live",
      "destination": "/index.html"
    },
    {
      "source": "/brief",
      "destination": "/index.html"
    },
    {
      "source": "/agents",
      "destination": "/index.html"
    },
    {
      "source": "/ask",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/rugs",
      "destination": "/index.html"
    },
    {
      "source": "/play",
      "destination": "/index.html"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    },
    {
      "source": "/stats",
      "destination": "/index.html"
    },
    {
      "source": "/roadmap",
      "destination": "/index.html"
    },
    {
      "source": "/radar",
      "destination": "/index.html"
    },
    {
      "source": "/xray",
      "destination": "/xray.html"
    }
  ],
  "redirects": [
    {
      "source": "/rug",
      "destination": "/rugs",
      "permanent": true
    },
    {
      "source": "/x-ray",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/scan",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/check",
      "destination": "/xray",
      "permanent": true
    },
    {
      "source": "/bot",
      "destination": "https://t.me/zooaiagency_bot",
      "permanent": true
    }
  ]
}

# One of: north | marsh | canyon
ZOO_ROLE=north
ZOO_NODE_ID=north.zoo
PORT=8787
# base64 PKCS#8 ed25519 key; generated into $ZOO_DATA_DIR/identity.key when unset
ZOO_NODE_SECRET=
ZOO_DATA_DIR=./data/north
# JSON array of { id, url, publicKey }
ZOO_PEERS=[]
ZOO_ADMIN_TOKEN=
ZOO_BRIEF_AT=07:00
ZOO_SCAN_EVERY_MS=600000
ZOO_FEED_GRANT=10000
ZOO_CORS_ORIGIN=*
# Solana, read live (north only). A Yellowstone gRPC endpoint for every pump.fun, PumpSwap, LaunchLab and Meteora
# transaction; without it the node serves no chain data. Shyft's endpoint and token work.
SHYFT_GRPC_URL=
SHYFT_GRPC_TOKEN=
# Or read the stream through a relay you run (scripts/relay.ts) instead of a direct gRPC connection.
# ZOO_RELAY_URL=
# ZOO_RELAY_TOKEN=
# A Solana RPC for holders, funder traces and where the SOL went after a dump. Helius is recommended: the
# transfer trace uses its enhanced transactions API, read from the api-key in this URL.
SOLANA_RPC_URL=
# Optional: a Helius key on its own, so SOLANA_RPC_URL can be another provider while history reads stay on Helius.
# HELIUS_API_KEY=
# Base (north only): Clanker read from a public endpoint by default.
# BASE_RPC_URL=
# Optional: lets builders and archivists think. Set one model provider's key; ZOO_MODEL picks the model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZOO_MODEL=
ZOO_JUDGE_EVERY_MS=1800000
# BNB Chain (north only): four.meme read from public endpoints, no keys. ZOO_BSC=off skips it.
# BSC_WS_URL=wss://bsc-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BSC_LOGS_URL=https://rpc.48.club
# Who paid for a four.meme creator: a Moralis key (free tier covers BNB Chain) or an Etherscan key on a paid plan. Without one, funders on BNB Chain are not traced.
MORALIS_API_KEY=
BSCSCAN_API_KEY=

# x402 (north only): sell the check and the X-Ray per request in USDC over HTTP 402. Both keys below turn it on.
# The fee payer's Solana secret key (JSON byte array as solana-keygen writes it, or base58). Keep a little SOL on it.
# X402_FACILITATOR_KEY=
# The wallet that receives USDC; its USDC token account must exist.
# X402_PAY_TO=
# devnet (default) or mainnet
# X402_NETWORK=devnet
# X402_RPC_URL=https://api.devnet.solana.com
# The public base URL named in the 402 as the resource.
# X402_PUBLIC_URL=https://north.zooaiagency.com
# Real USDC on Solana mainnet as well, offered first: its own fee payer (a little SOL) and payee (its USDC account must exist).
# X402_MAINNET_KEY=
# X402_MAINNET_PAY_TO=
# X402_MAINNET_RPC_URL=

# Telegram bot (canyon only): @BotFather's token.
# TELEGRAM_BOT_TOKEN=
# Swap fee loop (canyon only): the hot wallet that collects the 1% swap fee, and where the rest is swept.
# ZOO_FEE_WALLET_KEY=
# ZOO_FEE_WALLET_PUBKEY=
# ZOO_FEE_TREASURY=

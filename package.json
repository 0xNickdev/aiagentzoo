{
  "name": "aiagentzoo",
  "private": true,
  "description": "Who is behind a Solana memecoin, and where the money went: the X-Ray, tool prints, operators, and x402 pay-per-check for trading agents.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:web": "npm run dev -w @aiagentzoo/web",
    "dev:node": "npm run dev -w @aiagentzoo/node"
  }
}
